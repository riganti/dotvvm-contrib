@viewModel DotVVM.Contrib.InstallBar.Samples.ViewModels.MasterViewModel, DotVVM.Contrib.InstallBar.Samples

<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>InstallBar Samples</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon.svg" />
</head>
<body>

    <h1>InstallBar Samples</h1>
 
    <dot:Repeater DataSource="{value: AllSamples}" WrapperTagName="ul">
        <li style="display: inline-block">
            <a href="{value: _this}">{{value: _this}}</a>
        </li>
    </dot:Repeater>
    <hr />

	<dot:ContentPlaceHolder ID="MainContent" />

</body>
</html>
